    "@tailwindcss/typography": "^0.5.13",
    "@vueuse/core": "^10.11.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.7.2",
    "chart.js": "^4.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "defu": "^6.1.4",
    "fuse.js": "^7.0.0",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.7",
    "radix-vue": "^1.8.2",
    "tailwind-merge": "^2.3.0",
    "vue": "^3.4.29",
