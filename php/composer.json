{
    "name": "apexos/web",
    "description": "Apexos Web Services for Axel LMS (Laravel)",
    "type": "project",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Apexos Team",
            "email": "team@apexos.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "ext-sodium": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "ext-zlib": "*",

        "laravel/framework": "^11.0",
        "laravel/octane": "^2.0",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.0",
        "laravel/pulse": "^1.2",
        "laravel/horizon": "^5.0",
        "laravel/scout": "^10.0",

        "spatie/laravel-multitenancy": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-webhook-client": "^3.0",
        "spatie/laravel-webhook-server": "^3.0",
        "spatie/laravel-health": "^1.0",
        "spatie/laravel-schemaless-attributes": "^2.0",
        "spatie/laravel-translatable": "^6.0",
        "spatie/laravel-tags": "^4.0",
        "spatie/laravel-analytics": "^4.0",

        "league/oauth2-server": "^8.5",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "league/fractal": "^0.20",
        "league/csv": "^9.0",
        "league/html-to-markdown": "^5.0",
        "league/commonmark": "^2.0",

        "darkaonline/l5-swagger": "^8.0",
        "zircote/swagger-php": "^4.0",

        "predis/predis": "^2.0",
        "php-amqplib/php-amqplib": "^3.0",
        "vyuldashev/nats.php": "^1.0",

        "guzzlehttp/guzzle": "^7.0",
        "symfony/http-client": "^7.0",
        "symfony/process": "^7.0",
        "symfony/console": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/uid": "^7.0",
        "symfony/string": "^7.0",
        "symfony/cache": "^7.0",
        "symfony/rate-limiter": "^7.0",
        "symfony/mailer": "^7.0",
        "symfony/notifier": "^7.0",

        "ramsey/uuid": "^4.0",
        "ramsey/collection": "^2.0",
        "webmozart/assert": "^1.0",
        "doctrine/dbal": "^4.0",
        "doctrine/annotations": "^2.0",

        "vlucas/phpdotenv": "^5.0",
        "monolog/monolog": "^3.0",
        "open-telemetry/opentelemetry": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/api": "^1.0",

        "firebase/php-jwt": "^6.0",
        "lcobucci/jwt": "^5.0",
        "lcobucci/clock": "^3.0",

        "sabre/vobject": "^4.0",
        "sabre/dav": "^4.0",

        "scorm-cloud/php-sdk": "^2.0",
        "imsglobal/lti-1p3-tool": "^2.0",
        "imsglobal/lti-1p3-platform": "^2.0",

        "maennchen/zipstream-php": "^2.0",
        "php-ffmpeg/php-ffmpeg": "^1.0",

        "tightenco/collect": "^10.0",
        "illuminate/collections": "^11.0",
        "illuminate/support": "^11.0",
        "illuminate/pipeline": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/bus": "^11.0",
        "illuminate/queue": "^11.0",
        "illuminate/scheduling": "^11.0",
        "illuminate/filesystem": "^11.0",
        "illuminate/hashing": "^11.0",
        "illuminate/encryption": "^11.0",
        "illuminate/routing": "^11.0",
        "illuminate/session": "^11.0",
        "illuminate/auth": "^11.0",
        "illuminate/validation": "^11.0",
        "illuminate/translation": "^11.0",

        "aws/aws-sdk-php": "^3.0",
        "minio/minio": "^4.0",

        "meilisearch/meilisearch-php": "^1.0",
        "typesense/typesense-php": "^2.0",

        "barryvdh/laravel-debugbar": "^3.0",
        "barryvdh/laravel-ide-helper": "^3.0",
        "barryvdh/laravel-cors": "^3.0",
        "beyondcode/laravel-websockets": "^2.0",
        "beyondcode/laravel-dump-server": "^1.0",

        "nunomaduro/collision": "^7.0",
        "nunomaduro/larastan": "^3.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-parallel": "^2.0",
        "pestphp/pest-plugin-type-coverage": "^2.0",
        "rector/rector": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpstan/phpstan-strict-rules": "^1.0",
        "phpstan/extension-installer": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.0",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^11.0",
        "phpunit/php-code-coverage": "^11.0",
        "infection/infection": "^0.27",
        "vimeo/psalm": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Apexos\\WebApp\\": "web-app/src/",
            "Apexos\\AdminPanel\\": "admin-panel/src/",
            "Apexos\\LtiProvider\\": "lti-provider/src/",
            "Apexos\\ScormEngine\\": "scorm-engine/src/",
            "Apexos\\Shared\\": "shared/src/"
        },
        "files": [
            "shared/src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Apexos\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan octane:start --server=swoole --host=0.0.0.0 --port=8000 --watch"
        ],
        "test": "pest --parallel",
        "test:unit": "pest --filter=Unit",
        "test:integration": "pest --filter=Integration",
        "test:arch": "pest --filter=Architecture",
        "lint": "pint --test && phpstan analyse --memory-limit=2G && psalm --no-cache",
        "format": "pint",
        "stan": "phpstan analyse --memory-limit=2G",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models -N"
        ],
        "migrate": "php artisan migrate --force",
        "migrate:fresh": "php artisan migrate:fresh --seed --force",
        "seed": "php artisan db:seed --force",
        "horizon": "php artisan horizon",
        "schedule": "php artisan schedule:work",
        "queue": "php artisan queue:work --tries=3 --timeout=60",
        "websockets": "php artisan websockets:serve",
        "pulse": "php artisan pulse:check",
        "health": "php artisan health:check"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "branch-alias": {
            "dev-main": "11.x-dev"
        }
    }
}